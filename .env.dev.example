# Development stack environment — copy to .env.dev and fill in values.
# .env.dev is gitignored.

# ── Flask API ─────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=dev-only-insecure-key-change-me
FLASK_DEBUG=1

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=dev-root-password
MYSQL_DATABASE=dmtc_dev
MYSQL_USER=dmtc
MYSQL_PASSWORD=dev-db-password

# ── ORCID OAuth ───────────────────────────────────────────────────────────────
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_AUTH_URL=https://sandbox.orcid.org/oauth/authorize
ORCID_EXCHANGE_URL=https://sandbox.orcid.org/oauth/token
ORCID_REDIRECT_URL=http://localhost:8082/api/orcid_sign_in/orcid_callback

# ── Application URLs ──────────────────────────────────────────────────────────
FRONT_END_URL=http://localhost:8082
API_KEYS=
RSS_EMAIL=dev@example.com
VUE_APP_API_BASE=

# ── Host ports for dev stack ──────────────────────────────────────────────────
DEV_UI_PORT=8082
DEV_API_PORT=5001
DEV_SOLR_PORT=8984
DEV_MYSQL_PORT=3307
