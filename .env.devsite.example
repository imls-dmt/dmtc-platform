# Development-site environment (public dmtc-devel.org stack on the production
# droplet) — copy to .env.devsite and fill in values. .env.devsite is gitignored.
# Use different database passwords from production; the data here is a
# non-authoritative clone.

FLASK_SECRET_KEY=change-me
FLASK_DEBUG=0

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=dmtc_devsite
MYSQL_USER=dmtc
MYSQL_PASSWORD=change-me

SOLR_HEAP=768m

ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_AUTH_URL=https://orcid.org/oauth/authorize
ORCID_EXCHANGE_URL=https://orcid.org/oauth/token
ORCID_REDIRECT_URL=https://www.dmtc-devel.org/api/orcid_sign_in/orcid_callback

FRONT_END_URL=https://www.dmtc-devel.org
API_KEYS=
RSS_EMAIL=noreply@dmtc-devel.org
VUE_APP_API_BASE=
