# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# ── Flask API ─────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-generate-a-real-secret-key

# Set to 1 only during local development (enables Flask debug mode + reloader)
FLASK_DEBUG=0

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=dmtc
MYSQL_USER=dmtc
MYSQL_PASSWORD=change-me-db-password

# ── ORCID OAuth ───────────────────────────────────────────────────────────────
# Register at https://orcid.org/developer-tools
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_AUTH_URL=https://orcid.org/oauth/authorize
ORCID_EXCHANGE_URL=https://orcid.org/oauth/token
# Must match the redirect URI registered with ORCID
ORCID_REDIRECT_URL=http://localhost/api/orcid_sign_in/orcid_callback

# ── Application URLs ──────────────────────────────────────────────────────────
FRONT_END_URL=http://localhost

# Comma-separated list of API keys for programmatic access (may be empty)
API_KEYS=

# Email address used as the author in RSS feeds
RSS_EMAIL=noreply@example.com

# ── UI build ──────────────────────────────────────────────────────────────────
# Leave empty so the Vue app uses relative URLs proxied through nginx.
# Set to a full URL (e.g. https://api.example.com) only when the API and UI
# are deployed on separate origins.
VUE_APP_API_BASE=

# Port to expose the UI on the host (default 80)
UI_PORT=80
