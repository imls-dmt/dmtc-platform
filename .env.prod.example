# Production environment — copy to .env.prod on the droplet and fill in values.
# .env.prod is gitignored. Generate secrets with:  openssl rand -hex 32

# ── Hostnames and TLS ─────────────────────────────────────────────────────────
PROD_HOST=www.dmtc-prod.org
PROD_APEX=dmtc-prod.org
DEVSITE_HOST=www.dmtc-devel.org
DEVSITE_APEX=dmtc-devel.org
ACME_EMAIL=change-me@example.org
# TLS_MODE=internal gives self-signed certificates for staging before DNS moves;
# switch to acme (or remove) at cutover. ACME_CA may point at the Let's Encrypt
# staging directory while rehearsing.
TLS_MODE=acme
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Legacy ESIP name, served only once caddy/sites/legacy.caddy is enabled
LEGACY_HOST=dmtclearinghouse.esipfed.org

# ── Flask API ─────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=0

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=dmtc
MYSQL_USER=dmtc
MYSQL_PASSWORD=change-me

# ── Solr ──────────────────────────────────────────────────────────────────────
SOLR_HEAP=1g

# ── ORCID OAuth (production credentials from the ORCID developer tools page) ──
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_AUTH_URL=https://orcid.org/oauth/authorize
ORCID_EXCHANGE_URL=https://orcid.org/oauth/token
# The API appends "/<originating host>" to this; register both
# https://www.dmtc-prod.org/api/orcid_sign_in/orcid_callback/www.dmtc-prod.org
# and the dmtc-devel.org equivalent as redirect URIs with ORCID.
ORCID_REDIRECT_URL=https://www.dmtc-prod.org/api/orcid_sign_in/orcid_callback

# ── Application URLs ──────────────────────────────────────────────────────────
FRONT_END_URL=https://www.dmtc-prod.org
API_KEYS=
RSS_EMAIL=noreply@dmtc-prod.org
VUE_APP_API_BASE=

# ── Backups to DigitalOcean Spaces (scripts/backup-to-spaces.sh) ──────────────
SPACES_BUCKET=dmtc-backups
SPACES_REGION=nyc3
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
