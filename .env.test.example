# Testing stack environment — copy to .env.test and fill in values.
# .env.test is gitignored.
# Use production-strength secrets here; this stack validates pre-merge changes.

# ── Flask API ─────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-generate-a-real-secret-key
FLASK_DEBUG=0

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=test-root-password
MYSQL_DATABASE=dmtc_test
MYSQL_USER=dmtc
MYSQL_PASSWORD=test-db-password

# ── ORCID OAuth ───────────────────────────────────────────────────────────────
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_AUTH_URL=https://sandbox.orcid.org/oauth/authorize
ORCID_EXCHANGE_URL=https://sandbox.orcid.org/oauth/token
ORCID_REDIRECT_URL=http://localhost:8081/api/orcid_sign_in/orcid_callback

# ── Application URLs ──────────────────────────────────────────────────────────
FRONT_END_URL=http://localhost:8081
API_KEYS=
RSS_EMAIL=test@example.com
VUE_APP_API_BASE=

# ── Host port for test stack ──────────────────────────────────────────────────
TEST_UI_PORT=8081
