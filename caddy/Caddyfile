# Caddy front door for the DMTC droplet.
#
# Hostnames and the ACME contact come from the environment (see .env.prod).
# Each site lives in caddy/sites/*.caddy so the development site can be
# enabled or removed without touching production. Certificates are obtained
# automatically from Let's Encrypt on first request for each hostname, so
# DNS for a name must point here before its site block is loaded.
#
# Caddy adds the HTTP -> HTTPS redirect for every hostname below itself, with
# the path preserved (the bug in the old Apache config that broke bookmarks).
# Do not define a site on :80 here, or those automatic redirects are disabled.

{
	email {$ACME_EMAIL}
	# Production CA by default. Set ACME_CA in .env.prod to
	# https://acme-staging-v02.api.letsencrypt.org/directory while rehearsing.
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

# TLS_MODE selects caddy/tls/<mode>.caddy: "acme" (default) or "internal"
# (self-signed, for staging before DNS moves). Imported by each site block.

# Internal liveness endpoint for the container healthcheck; not published.
:8080 {
	respond /healthz "ok" 200
}

import sites/*.caddy
