# Development site: www.dmtc-devel.org, served from the dmtc-devsite compose
# project over the shared dmtc-edge network. Remove or rename this file
# (e.g. devsite.caddy.off) to disable the development site.

{$DEVSITE_APEX} {
	import /etc/caddy/tls/{$TLS_MODE:acme}.caddy
	redir https://{$DEVSITE_HOST}{uri} permanent
}

{$DEVSITE_HOST} {
	import /etc/caddy/tls/{$TLS_MODE:acme}.caddy
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Site content (markdown, JSON, images) comes straight from a checkout of
	# the ui-static-content repository mounted at /srv/content-devsite, refreshed by cron.
	# Editors publish by merging to that repository; no UI rebuild is needed.
	@content path /source/* /images/*
	handle @content {
		root * /srv/content-devsite
		header Cache-Control "public, max-age=300"
		file_server
	}

	# Everything else: nginx in the ui container serves the SPA and proxies
	# /api/ to the API. X-Forwarded-Host is what the API uses for the ORCID callback.
	handle {
		reverse_proxy ui-devsite:80 {
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
