# Production sync credentials — copy to .env.prod-sync and fill in values.
# .env.prod-sync is gitignored. Never commit real credentials.

# ── SSH access to the production host ────────────────────────────────────────
PROD_SSH_HOST=dmtc-prod.example.org
PROD_SSH_USER=deploy

# ── MySQL on the production host ──────────────────────────────────────────────
PROD_DB_HOST=localhost
PROD_DB_PORT=3306
PROD_DB_USER=dmtc_prod
PROD_DB_PASS=change-me
PROD_DB_NAME=dmtc

# ── Anonymization ─────────────────────────────────────────────────────────────
# Set to 1 to scramble email/name fields before importing into local stacks.
# Recommended for any developer environment that won't be immediately discarded.
ANONYMIZE_USERS=1
